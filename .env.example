# Server
APP_PORT=8080

# SQLite (banco de metadados interno — jobs e logs)
DB_PATH=./data/sharepoint.db

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Microsoft Graph API — credenciais do Azure App Registration (client credentials flow)
# GRAPH_TENANT_ID: UUID do tenant — extraia da authority URL: https://login.microsoftonline.com/{TENANT_ID}
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret

# Migration Writer — tamanho do batch JDBC por execução de INSERT
WRITER_BATCH_SIZE=500

# Debug
JPA_SHOW_SQL=false
