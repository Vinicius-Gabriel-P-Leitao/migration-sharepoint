# Server
APP_PORT=8080

# SQLite
DB_PATH=./data/sharepoint.db

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Microsoft Graph API
GRAPH_TOKEN=eyJ0eXAiOiJKV1Q...
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret

# Microsoft Graph API tuning (optional)
GRAPH_PAGE_SIZE=999

# Migration Writer tuning (optional)
WRITER_BATCH_SIZE=500

# Debug
JPA_SHOW_SQL=false
